# Copie este arquivo para .env e preencha os valores reais.
# NUNCA cometa o arquivo .env real no Git.

# String de conexão com o PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/projeto_ms
DATABASE_URL="postgresql://usuario:senha@localhost:5432/projeto_ms"

# NextAuth
# Gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# (Opcional) Login com Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
