// Schema Prisma — Projeto MS (Fase 2)
// Reflete o modelo de dados descrito no PRD (seção 4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// AUTENTICAÇÃO (NextAuth — modelo padrão adaptado)
// ---------------------------------------------------------------------

enum AppRole {
  admin
  gestor
  analista_fiscal
  juridico
  comercial
  aprovador
  lead_cliente
}

enum UserStatus {
  ativo
  inativo
  bloqueado

  @@map("user_status")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // login por e-mail/senha
  status        UserStatus @default(ativo)
  lastAccessAt  DateTime? // "último acesso" (PRD 6.10)
  linkedLeadId  String? // Lead/Cliente vinculado — obrigatório para o perfil lead_cliente
  linkedLead    Lead?      @relation("LeadClientUser", fields: [linkedLeadId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles     UserRole[]
  accounts  Account[]
  sessions  Session[]
  leadsOwned Lead[]        @relation("LeadOwner")
  documents  Document[]    @relation("DocumentUploadedBy")
  spedFiles  SpedFile[]    @relation("SpedFileUploadedBy")
  analises   AnaliseFiscal[] @relation("AnaliseAnalyst")
  leadClientFlagChanges LeadClientFlagLog[] @relation("LeadClientFlagChangedBy")

  @@map("users")
}

model UserRole {
  id     String  @id @default(cuid())
  userId String
  role   AppRole
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

// Modelos padrão exigidos pelo @next-auth/prisma-adapter
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------
// DOMÍNIO DO PRODUTO
// ---------------------------------------------------------------------

// LeadStatus e CompanyType (ver adiante) alinhados ao PRD seção 6.3/7.1 —
// substituem o antigo enum LeadStage do MVP inicial.

enum CompanyType {
  industria
  comercio
  revenda
  servicos

  @@map("company_type")
}

enum LeadStatus {
  novo
  qualificacao
  reuniao_agendada
  documentacao
  analise_fiscal
  proposta
  contrato
  aprovado
  cancelado

  @@map("lead_status")
}

model Lead {
  id             String      @id @default(cuid())
  companyName    String
  cnpj           String?
  companyType    CompanyType?
  contactName    String?
  contactEmail   String?
  phone          String?
  status         LeadStatus  @default(novo)
  estimatedValue Decimal     @default(0) @db.Decimal(14, 2)
  procurationSigned Boolean  @default(false)
  ndaSigned         Boolean  @default(false)
  isClient          Boolean  @default(false) // "Cliente" — alterações ficam registradas em LeadClientFlagLog

  // Endereço completo (aba própria no cadastro/edição do lead)
  addressZip          String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?

  notes          String?
  ownerId        String?
  owner          User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  documents       Document[]
  analises        AnaliseFiscal[]
  approvals       Aprovacao[]
  projects        Project[]
  spedFiles       SpedFile[]
  clientFlagLogs  LeadClientFlagLog[]
  clientUsers     User[]              @relation("LeadClientUser")

  @@map("leads")
}

// Log de auditoria do campo "Cliente" (isClient) — registra cada alteração,
// por quem foi feita e quando.
model LeadClientFlagLog {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value       Boolean
  changedById String?
  changedBy   User?    @relation("LeadClientFlagChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now())

  @@index([leadId])
  @@map("lead_client_flag_logs")
}

enum ProjectStatus {
  planejamento
  importacao
  auditoria
  analise
  aprovacao
  protocolo
  concluido
}

model Project {
  id                String        @id @default(cuid())
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name              String
  status            ProjectStatus @default(planejamento)
  periodStart       DateTime?
  periodEnd         DateTime?
  prescriptionDate  DateTime? // controle de prescrição (5 anos)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  documents        Document[]  // legado: FK antiga (ver nota no model Document) — mantido só por compat de include já em uso
  inconsistencies  Inconsistency[]
  taxCredits       TaxCredit[]
  spedFiles        SpedFile[]

  @@map("projects")
}

enum DocType {
  procuracao
  nda
  contrato
  aditivo
  outro

  @@map("doc_type")
}

enum DocStatus {
  enviado
  pendente
  validado
  rejeitado

  @@map("doc_status")
}

model Document {
  id           String    @id @default(cuid())
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Campo legado do MVP inicial (documentos vinculados a Projeto). Mantido apenas
  // para não quebrar dados já existentes; o cadastro atual (PRD 6.4) usa `leadId`.
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  type         DocType   @default(outro)
  version      Int       @default(1)
  status       DocStatus @default(enviado)
  sizeKb       Int       @default(0)
  storagePath  String?
  note         String?
  uploadedById String?
  uploadedBy   User?     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([leadId])
  @@map("documents")
}

enum Severity {
  baixa
  media
  alta
  critica
}

model Inconsistency {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  description String
  severity    Severity @default(media)
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("inconsistencies")
}

enum CreditStatus {
  identificado
  em_analise
  aprovado
  protocolado
  recuperado
  rejeitado
}

model TaxCredit {
  id          String       @id @default(cuid())
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taxType     String
  thesis      String?
  amount      Decimal      @default(0) @db.Decimal(14, 2)
  status      CreditStatus @default(identificado)
  competence  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tax_credits")
}

// ---------------------------------------------------------------------
// IMPORTAÇÃO E CONTROLE DE ARQUIVOS SPED (PRD seções 6.5 / 6.6 / 8.3)
// ---------------------------------------------------------------------

enum SpedFileType {
  efd_icms_ipi
  efd_contribuicoes

  @@map("sped_file_type")
}

enum SpedFileStatus {
  sucesso
  aviso
  erro
  duplicado

  @@map("sped_file_status")
}

model SpedFile {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      SpedFileType
  status    SpedFileStatus @default(sucesso)

  // Arquivo
  fileName    String
  fileSizeKb  Int      @default(0)

  // Identificação do contribuinte (registro 0000)
  companyName    String?
  cnpj           String?
  ie             String?
  uf             String?
  periodStart    String? // YYYY-MM
  periodEnd      String? // YYYY-MM

  // Totais de processamento (para KPIs)
  totalRecords   Int @default(0)
  warningsCount  Int @default(0)
  errorsCount    Int @default(0)

  // Dados extraídos estruturados (apuração ICMS, PIS/COFINS, NFs, ajustes, avisos e erros)
  extracted Json?

  uploadedById String?
  uploadedBy   User?    @relation("SpedFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  // Preenchido quando status = 'duplicado': aponta para o arquivo já importado anteriormente
  // (mesmo CNPJ + tipo + período), usado para registrar a tentativa sem duplicar os dados extraídos.
  duplicateOfId String?

  @@index([projectId])
  @@index([leadId])
  @@index([type])
  @@map("sped_files")
}

// ---------------------------------------------------------------------
// ANÁLISE FISCAL (PRD 6.7 / 7.2)
// ---------------------------------------------------------------------

enum TaxType {
  pis_cofins
  icms
  ipi
  irpj_csll
  outros

  @@map("tax_type")
}

enum AnaliseStatus {
  em_andamento
  concluida
  aprovada
  rejeitada

  @@map("analise_status")
}

model AnaliseFiscal {
  id              String        @id @default(cuid())
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  taxType         TaxType
  thesis          String
  periodStart     String // YYYY-MM
  periodEnd       String // YYYY-MM
  estimatedCredit Decimal       @default(0) @db.Decimal(14, 2)
  status          AnaliseStatus @default(em_andamento)
  diagnosis       String?
  analystId       String?
  analyst         User?         @relation("AnaliseAnalyst", fields: [analystId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  checklist ChecklistItem[]
  approvals Aprovacao[]

  @@index([leadId])
  @@map("analises_fiscais")
}

model ChecklistItem {
  id          String        @id @default(cuid())
  analiseId   String
  analise     AnaliseFiscal @relation(fields: [analiseId], references: [id], onDelete: Cascade)
  description String
  done        Boolean       @default(false)
  order       Int           @default(0)

  @@index([analiseId])
  @@map("checklist_items")
}

// ---------------------------------------------------------------------
// APROVAÇÕES MULTIDISCIPLINARES (PRD 6.9 / 7.4)
// ---------------------------------------------------------------------

enum ApprovalArea {
  juridico
  financeiro
  comercial
  concorrencia

  @@map("approval_area")
}

enum ApprovalStatus {
  pendente
  aprovado
  rejeitado

  @@map("approval_status")
}

model Aprovacao {
  id         String         @id @default(cuid())
  leadId     String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  analiseId  String
  analise    AnaliseFiscal  @relation(fields: [analiseId], references: [id], onDelete: Cascade)
  area       ApprovalArea
  status     ApprovalStatus @default(pendente)
  decidedBy  String?
  decidedAt  DateTime?
  note       String? // obrigatória em caso de rejeição (validado na aplicação)
  createdAt  DateTime       @default(now())

  @@unique([analiseId, area])
  @@index([leadId])
  @@map("aprovacoes")
}
