generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  status        UserStatus      @default(ativo)
  lastAccessAt  DateTime?
  linkedLeadId  String?
  accounts      Account[]
  analises      AnaliseFiscal[] @relation("AnaliseAnalyst")
  documents     Document[]      @relation("DocumentUploadedBy")
  spedFiles     SpedFile[]      @relation("SpedFileUploadedBy")
  leadsOwned    Lead[]          @relation("LeadOwner")
  sessions      Session[]
  roles         UserRole[]
  linkedLead    Lead?           @relation("ClientUsers", fields: [linkedLeadId], references: [id])

  @@map("users")
}

model UserRole {
  id     String  @id @default(cuid())
  userId String
  role   AppRole
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id        String    @id @default(cuid())
  name      String
  cnpj      String?
  segment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@map("clients")
}

model Lead {
  id                String          @id @default(cuid())
  companyName       String
  contactName       String?
  contactEmail      String?
  estimatedValue    Decimal         @default(0) @db.Decimal(14, 2)
  ownerId           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cnpj              String?
  companyType       CompanyType?
  phone             String?
  notes             String?
  procurationSigned Boolean         @default(false)
  ndaSigned         Boolean         @default(false)
  status            LeadStatus      @default(novo)
  analises          AnaliseFiscal[]
  approvals         Aprovacao[]
  documents         Document[]
  owner             User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  clientUsers       User[]          @relation("ClientUsers")

  @@map("leads")
}

model Project {
  id               String          @id @default(cuid())
  clientId         String?
  name             String
  status           ProjectStatus   @default(planejamento)
  periodStart      DateTime?
  periodEnd        DateTime?
  prescriptionDate DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  documents        Document[]
  inconsistencies  Inconsistency[]
  spedFiles        SpedFile[]
  client           Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxCredits       TaxCredit[]

  @@map("projects")
}

model Document {
  id           String    @id @default(cuid())
  projectId    String?
  name         String
  docType      String?
  version      Int       @default(1)
  storagePath  String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  leadId       String?
  type         DocType   @default(outro)
  status       DocStatus @default(enviado)
  sizeKb       Int       @default(0)
  note         String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([leadId])
  @@map("documents")
}

model Inconsistency {
  id          String   @id @default(cuid())
  projectId   String?
  code        String
  description String
  severity    Severity @default(media)
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("inconsistencies")
}

model TaxCredit {
  id         String       @id @default(cuid())
  projectId  String?
  taxType    String
  thesis     String?
  amount     Decimal      @default(0) @db.Decimal(14, 2)
  status     CreditStatus @default(identificado)
  competence DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tax_credits")
}

model AnaliseFiscal {
  id              String          @id @default(cuid())
  leadId          String
  taxType         TaxType
  thesis          String
  periodStart     String
  periodEnd       String
  estimatedCredit Decimal         @default(0) @db.Decimal(14, 2)
  status          AnaliseStatus   @default(em_andamento)
  diagnosis       String?
  analystId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  analyst         User?           @relation("AnaliseAnalyst", fields: [analystId], references: [id])
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  approvals       Aprovacao[]
  checklist       ChecklistItem[]

  @@index([leadId])
  @@map("analises_fiscais")
}

model ChecklistItem {
  id          String        @id @default(cuid())
  analiseId   String
  description String
  done        Boolean       @default(false)
  order       Int           @default(0)
  analise     AnaliseFiscal @relation(fields: [analiseId], references: [id], onDelete: Cascade)

  @@index([analiseId])
  @@map("checklist_items")
}

model Aprovacao {
  id        String         @id @default(cuid())
  leadId    String
  analiseId String
  area      ApprovalArea
  status    ApprovalStatus @default(pendente)
  decidedBy String?
  decidedAt DateTime?
  note      String?
  createdAt DateTime       @default(now())
  analise   AnaliseFiscal  @relation(fields: [analiseId], references: [id], onDelete: Cascade)
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([analiseId, area])
  @@index([leadId])
  @@map("aprovacoes")
}

model SpedFile {
  id            String         @id @default(cuid())
  projectId     String?
  type          SpedFileType
  status        SpedFileStatus @default(sucesso)
  fileName      String
  fileSizeKb    Int            @default(0)
  companyName   String?
  cnpj          String?
  ie            String?
  uf            String?
  periodStart   String?
  periodEnd     String?
  totalRecords  Int            @default(0)
  warningsCount Int            @default(0)
  errorsCount   Int            @default(0)
  extracted     Json?
  uploadedById  String?
  createdAt     DateTime       @default(now())

  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("SpedFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([type])
  @@map("sped_files")
}

enum SpedFileType {
  efd_icms_ipi
  efd_contribuicoes

  @@map("sped_file_type")
}

enum SpedFileStatus {
  sucesso
  aviso
  erro

  @@map("sped_file_status")
}

enum AppRole {
  admin
  gestor
  analista_fiscal
  juridico
  comercial
  aprovador
  cliente_consulta
}

enum UserStatus {
  ativo
  inativo
  bloqueado

  @@map("user_status")
}

enum CompanyType {
  industria
  comercio
  revenda
  servicos

  @@map("company_type")
}

enum LeadStatus {
  novo
  qualificacao
  reuniao_agendada
  documentacao
  analise_fiscal
  proposta
  contrato
  aprovado
  cancelado

  @@map("lead_status")
}

enum ProjectStatus {
  planejamento
  importacao
  auditoria
  analise
  aprovacao
  protocolo
  concluido
}

enum DocType {
  procuracao
  nda
  contrato
  aditivo
  outro

  @@map("doc_type")
}

enum DocStatus {
  enviado
  pendente
  validado
  rejeitado

  @@map("doc_status")
}

enum Severity {
  baixa
  media
  alta
  critica
}

enum CreditStatus {
  identificado
  em_analise
  aprovado
  protocolado
  recuperado
  rejeitado
}

enum TaxType {
  pis_cofins
  icms
  ipi
  irpj_csll
  outros

  @@map("tax_type")
}

enum AnaliseStatus {
  em_andamento
  concluida
  aprovada
  rejeitada

  @@map("analise_status")
}

enum ApprovalArea {
  juridico
  financeiro
  comercial
  concorrencia

  @@map("approval_area")
}

enum ApprovalStatus {
  pendente
  aprovado
  rejeitado

  @@map("approval_status")
}
